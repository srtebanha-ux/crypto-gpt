# Copie para .env.local (ou exporte no shell) e preencha. Nunca commite
# suas chaves reais — este arquivo é só um modelo.

# Chave de API da Binance com permissão de TRADE apenas — NUNCA habilite
# permissão de saque (withdrawal) nesta chave. Recomenda-se também
# restringir por IP allowlist no painel da Binance.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Capital base em USD alocado ao ciclo de arbitragem triangular.
CAPITAL_USD=50.00

# Tolerância mínima de lucro líquido acima do capital para disparar um ciclo.
MAX_SLIPPAGE=0.0005

# Por padrão (BINANCE_LIVE não setado ou != "true") o engine roda contra o
# Spot Testnet da Binance — fills simulados, sem risco financeiro.
# Para operar com dinheiro real, é preciso setar as DUAS variáveis abaixo:
BINANCE_LIVE=false
BINANCE_LIVE_CONFIRM=

# Kill switch estatístico (EWMA/z-score) — ver README. Deixe em branco para
# usar os padrões de produção (20 amostras, z >= 3, alpha 0.05).
STAT_MIN_SAMPLES=
STAT_Z_THRESHOLD=
RATIO_EWMA_ALPHA=

# Circuit breaker de perda máxima: para o engine permanentemente se o
# capital cair essa fração abaixo do inicial (0.10 = 10%). Configure com
# atenção antes de operar com dinheiro real — ver README.
MAX_DRAWDOWN_FRACTION=0.10

# Intervalo (minutos) do log de heartbeat em operação 24/7. 0 desativa.
HEARTBEAT_INTERVAL_MIN=5
