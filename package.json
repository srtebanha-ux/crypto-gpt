{
  "name": "crypto-gpt",
  "version": "0.1.0",
  "description": "HFT triangular arbitrage engine (delta-neutral, decimal-precision) for crypto-gpt",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "live": "ts-node src/live.ts",
    "live:prod": "node dist/live.js",
    "directional": "ts-node src/directionalLive.ts",
    "directional:prod": "node dist/directionalLive.js",
    "sniff": "ts-node src/opportunitySniffer.ts",
    "sniff:prod": "node dist/opportunitySniffer.js",
    "sniff-funding": "ts-node src/fundingRateSniffer.ts",
    "sniff-funding:prod": "node dist/fundingRateSniffer.js",
    "sniff-dex": "ts-node src/dexArbitrageSniffer.ts",
    "sniff-dex:prod": "node dist/dexArbitrageSniffer.js",
    "backtest": "ts-node src/backtestRunner.ts",
    "backtest:prod": "node dist/backtestRunner.js",
    "simulate": "ts-node src/monteCarloSimulation.ts",
    "paper-trade": "ts-node src/paperTradingSimulation.ts",
    "smoke-test-order": "ts-node src/smokeTestOrder.ts",
    "smoke-test-order:prod": "node dist/smokeTestOrder.js",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --require ts-node/register --test src/*.test.ts"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
